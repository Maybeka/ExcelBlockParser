{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/excel-block-parser/project-v3.schema.json",
  "title": "Excel Block Parser Project v3",
  "type": "object",
  "required": ["version", "exportedAt", "project", "data", "blockResults"],
  "properties": {
    "version": { "const": 3 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "required": ["id", "name", "workbooks", "activeWorkbookId", "blocks", "regions", "activeBlockId", "activeRegionId", "focusMode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "workbooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "sourcePath": { "type": "string", "minLength": 1 },
              "sheetNames": { "type": "array", "items": { "type": "string" } },
              "activeSheetName": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "activeWorkbookId": { "type": ["string", "null"] },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/projectItem" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/projectItem" } },
        "activeBlockId": { "type": "string" },
        "activeRegionId": { "type": ["string", "null"] },
        "focusMode": { "enum": ["always-editable", "activate-first"] }
      },
      "additionalProperties": true
    },
    "data": { "type": "object" },
    "blockResults": { "type": "array" },
    "regionResults": { "type": "array" }
  },
  "$defs": {
    "projectItem": {
      "type": "object",
      "required": ["id", "workbookId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "workbookId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
