{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excel-block-parser.io/schema/session-v2.json",
  "title": "Excel Block Parser session v2",
  "type": "object",
  "required": ["version", "exportedAt", "config", "data", "blockResults"],
  "properties": {
    "version": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "sourceFileName": { "type": "string" },
    "config": {
      "type": "object",
      "required": ["blocks", "activeBlockId", "focusMode", "regions"],
      "properties": {
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "activeBlockId": { "type": "string" },
        "focusMode": { "enum": ["always-editable", "activate-first"] },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } }
      }
    },
    "data": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "object" } } },
    "blockResults": { "type": "array", "items": { "$ref": "#/$defs/blockResult" } },
    "regionResults": { "type": "array", "items": { "$ref": "#/$defs/regionResult" } }
  },
  "$defs": {
    "range": {
      "type": ["object", "null"],
      "properties": {
        "startRow": { "type": "integer", "minimum": 0 },
        "startCol": { "type": "integer", "minimum": 0 },
        "endRow": { "type": "integer", "minimum": 0 },
        "endCol": { "type": "integer", "minimum": 0 },
        "a1Notation": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "label", "range", "activeSheet", "headerRows", "columns"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "range": { "$ref": "#/$defs/range" },
        "activeSheet": { "type": ["string", "null"] },
        "headerRows": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "columns": { "type": "array" }
      }
    },
    "region": {
      "type": "object",
      "required": ["id", "label", "range", "activeSheet", "splitRules", "blocks"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "range": { "$ref": "#/$defs/range" },
        "activeSheet": { "type": ["string", "null"] },
        "splitRules": { "type": "array" },
        "blocks": { "type": "array" }
      }
    },
    "blockResult": {
      "type": "object",
      "required": ["blockId", "label", "data", "rowCount"],
      "properties": {
        "blockId": { "type": "string" },
        "label": { "type": "string" },
        "data": { "type": "array", "items": { "type": "object" } },
        "rowCount": { "type": "integer", "minimum": 0 }
      }
    },
    "regionResult": {
      "type": "object",
      "required": ["regionId", "label", "blocks"],
      "properties": {
        "regionId": { "type": "string" },
        "label": { "type": "string" },
        "blocks": { "type": "array" }
      }
    }
  }
}
