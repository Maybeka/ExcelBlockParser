{
  "name": "excel-block-parser",
  "version": "0.1.0",
  "description": "Load Excel, select a block, configure parsing, export JSON",
  "author": "Your Name",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "pack:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack:all": "npm run build && electron-builder --mac --win --linux",
    "build:vite": "vite build --config vite.config.ts",
    "dev:vite": "vite --config vite.config.ts"
  },
  "build": {
    "appId": "com.yourname.excel-block-parser",
    "productName": "Excel Block Parser",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/**/aws-sdk/**",
      "!node_modules/**/@esbuild/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@univerjs/core": "0.22.0",
    "@univerjs/preset-sheets-core": "0.22.0",
    "@univerjs/presets": "0.22.0",
    "antd": "^5.24.0",
    "exceljs": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "playwright": "^1.60.0",
    "typescript": "^5.5.0"
  }
}
