{
  "name": "excel-block-parser",
  "version": "1.7.4",
  "description": "Load Excel, select a block, configure parsing, export JSON",
  "author": "Excel Block Parser contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-univer-outline.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "setup:git-hooks": "node scripts/install-git-hooks.mjs",
    "verify:prepush": "node scripts/pre-push-check.mjs",
    "dev": "node scripts/patch-univer-outline.mjs && electron-vite dev",
    "build": "node scripts/patch-univer-outline.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:unit": "vitest run",
    "generate:fixtures": "node examples/generate-test-data.mjs",
    "benchmark:workbook": "node scripts/benchmark-workbook.mjs",
    "test:release": "node --test scripts/release-version.test.mjs scripts/windows-powershell.test.mjs",
    "package:wails:win": "node scripts/package-wails-windows.mjs",
    "test:main": "vitest run --config vitest.main.config.ts",
    "test:native": "npm run build && playwright test --config playwright.electron.config.ts tests-native/electron-smoke.spec.ts",
    "test:native:full": "npm run build && playwright test --config playwright.electron.config.ts",
    "test:packaged": "npm run pack:dir && node scripts/run-packaged-e2e.mjs",
    "test:unit:watch": "vitest",
    "pack:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "pack:all": "npm run build && electron-builder --mac --win --linux --publish never",
    "pack:dir": "npm run build && electron-builder --dir --publish never",
    "build:vite": "vite build --config vite.config.ts",
    "dev:vite": "vite --config vite.config.ts"
  },
  "build": {
    "appId": "io.excelblockparser.desktop",
    "productName": "Excel Block Parser",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/**/aws-sdk/**",
      "!node_modules/**/@esbuild/**"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon-transparent.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "publisherName": [
        "Excel Block Parser"
      ],
      "signingHashAlgorithms": [
        "sha256"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@univerjs/core": "0.22.0",
    "@univerjs/preset-sheets-core": "0.22.0",
    "@univerjs/preset-sheets-drawing": "0.22.0",
    "@univerjs/preset-sheets-filter": "0.22.0",
    "@univerjs/presets": "0.22.0",
    "antd": "^5.24.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.4.8",
    "mathjax": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@microlink/react-json-view": "^1.31.20",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "playwright": "^1.60.0",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
